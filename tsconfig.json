{
  "compilerOptions": {
    "target": "es2021",
    "module": "esnext",
    "lib": ["dom", "es2021"],
    "jsx": "react-jsx",
    "strict": true,
    "pretty": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true
  },
  // electron.vite.config.ts is checked by running it: TS 4.9's "node"
  // resolution can't read Vite 8's package exports. Revisit with TS 5 and
  // "moduleResolution": "bundler".
  "exclude": ["out", "release/build", "electron.vite.config.ts"]
}
