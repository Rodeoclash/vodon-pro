{
  "name": "vodon-pro",
  "version": "1.9.13",
  "description": "The synchronised VOD review tool",
  "main": "./out/main/main.js",
  "scripts": {
    "start": "electron-vite dev --watch",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder build --publish never",
    "publish": "electron-vite build && electron-builder build --publish always",
    "postinstall": "install-electron",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "build": {
    "productName": "VodonPro",
    "appId": "org.vodon.VodonPro",
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}",
      "node_modules/ffmpeg-ffprobe-static/**"
    ],
    "files": [
      "out/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": {
        "target": "default",
        "arch": [
          "arm64",
          "x64"
        ]
      },
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Rodeoclash",
      "repo": "vodon-pro"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rodeoclash/vodon-pro.git"
  },
  "author": {
    "name": "Samuel Richardson",
    "email": "sam@richardson.co.nz",
    "url": "https://www.richardson.co.nz"
  },
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rodeoclash/vodon-pro/issues"
  },
  "keywords": [
    "video",
    "esports"
  ],
  "homepage": "https://github.com/Rodeoclash/vodon-pro/blob/main/README.md",
  "devDependencies": {
    "@chakra-ui/react": "^1.8.9",
    "@emoji-mart/data": "^1.0.5",
    "@emoji-mart/react": "^1.0.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@playwright/test": "^1.65.1",
    "@popperjs/core": "^2.11.5",
    "@react-hook/throttle": "^2.2.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^12.1.5",
    "@tldraw/tldraw": "1.20.0",
    "@types/node": "^24.19.2",
    "@types/react": "^17.0.43",
    "@types/react-dom": "^17.0.14",
    "@types/uuid": "^9.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "emoji-mart": "^5.2.1",
    "history": "^5.3.0",
    "immer": "^9.0.12",
    "jsdom": "^31.0.1",
    "keyv": "^4.5.0",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-bus": "^3.0.0",
    "react-dom": "^17.0.2",
    "react-draggable": "^4.4.4",
    "react-dropzone": "^14.2.2",
    "react-hotkeys-hook": "^3.4.4",
    "react-popper": "^2.3.0",
    "react-router-dom": "^6.3.0",
    "superjson": "^1.8.2",
    "tabler-icons-react": "^1.45.0",
    "typescript": "^4.5.0",
    "use-pan-and-zoom": "^0.6.5",
    "uuid": "^9.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^3.7.1"
  },
  "dependencies": {
    "electron-debug": "^5.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "ffmpeg-ffprobe-static": "^6.1.1",
    "fluent-ffmpeg": "^2.1.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "ffmpeg-ffprobe-static@6.1.1": true
  }
}
